# NammaBasket environment variables.
# Copy to .env (which is ignored by Git) and fill in your own values. Never commit real passwords.
# Every variable is optional for local development: with none set, the app starts on an
# in-memory database with demo data at http://localhost:8080.

# ---- Database (PostgreSQL) ----
# Leave DB_URL empty to use the in-memory H2 database (data is lost when the app stops).
# Production: an EMPTY PostgreSQL database; Flyway creates the tables on first start.
DB_URL=jdbc:postgresql://localhost:5432/nammabasket
DB_USER=nammabasket
DB_PASSWORD=change-me

# ---- Web server ----
# Port the app listens on (Render sets this itself)
PORT=8080
# true when the site is served over HTTPS (production), false for http://localhost
COOKIE_SECURE=false

# ---- Admin account (created on first start) ----
ADMIN_EMAIL=admin@example.com
# Use a long, unique password. If empty, a random password is generated and printed once in the app log.
ADMIN_PASSWORD=change-me-too

# ---- Demo data ----
# true = add 3 more demo shops with about 45 products and photos, next to the starter demo kirana
# that is always created (safe: existing rows are never changed)
DEMO_SHOPS=true
# Password for the demo shop owner accounts (e.g. lakshmi.provisions@demo.nammabasket.in).
# Empty = the demo owners get a random password and nobody can log in as them.
DEMO_SELLER_PASSWORD=
